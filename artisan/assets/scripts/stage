#!/usr/bin/env python3
import sys
import os
from colorama import Fore, Style
import shutil

from artisan.ast import Ast
from artisan.source_manager import CLSources
import artisan.cmdline as cmdline
from artisan.storage import copy_tree
from artisan.preprocessor import preprocess

options = []
args = ""
for elem in sys.argv[1:]:
    if len(elem) >= 2 and elem[0:2] == '--':
       options.append(elem)
    else:
       args = args + " " + "\"" + elem + "\""

if len(args) == 0 and len(options) == 0:
    print("\nsyntax: %s [--preprocess] [--view] [--tree] [--loopback] [--clean] <src1.cpp> ... [-I..] [-D...]\n" % os.path.basename(__file__))
    sys.exit(0)

if '--clean' in options:
    if os.path.isdir('loopback'):
       shutil.rmtree('loopback')
    if os.path.isdir('preprocess'):
       shutil.rmtree('preprocess')

if '--preprocess' in options:
    preprocess_option = True
    (srcnames, args, defs) = cmdline.parse(args)
    sources = CLSources(srcnames, workdir=None)

    copy_tree(sources.workdir, 'preprocess')

    for src in sources:
       filename = os.path.join('preprocess', src.name)
       with open(filename, 'r') as f:
          code = f.read()

       with open(filename, 'w+') as f:
          print(f"[i] writing... (preprocess) {Fore.LIGHTRED_EX}%s{Style.RESET_ALL}" % filename)
          code = preprocess(code=code, defs=defs, args=args, control=1)
          print(code, file=f)
    print(f"[i] done... check {Fore.LIGHTBLUE_EX}preprocess/{Style.RESET_ALL} folder")
else:
    preprocess_option = False

if not preprocess_option:
    if len(args) != 0:
        app = Ast(cmd=args)
    else:
        app = None

    if '--loopback' in options:
        loopback = True
        if app:
            loopback = True
            app.export_to('loopback', overwrite=True)
            print(f"[i] done... check {Fore.LIGHTBLUE_EX}loopback/{Style.RESET_ALL} folder")
        else:
            print("[x] Error: no sources specified to loopback!")
            sys.exit(-1)
    else:
        loopback = False

    if '--view' in options:
        if app:
            app.view()
        else:
            print("[x] Error: no sources specified to view!")
            sys.exit(-1)

    if '--tree' in options:
        if app:
            app.tree()
        else:
            print("[x] Error: no sources specified to display tree!")
            sys.exit(-1)

print("[i] success!")

