#!/bin/bash

# Define ANSI color codes as environment variables
RED='\033[0;31m'
BLUE='\033[0;34m'
RESET='\033[0m'

# Check if environment.yml exists
if [[ ! -f "environment.yml" ]]; then
    echo -e "${RED}[x] error: environment.yml not found in the current directory!${RESET}"
    exit 1
fi

# Extract the environment name from the environment.yml file
ENV_NAME=$(grep -m 1 "^name:" environment.yml | awk '{print $2}')

if [ "$CONDA_DEFAULT_ENV" != "conda-build" ]; then
echo -e "${RED}[x] error: please activate 'conda-build' environment!${RESET}"
exit 1
fi

if [ "$#" -gt 1 ]; then
    echo -e "${RED}[x] syntax: $0 [python-version]${RESET}"
    exit 1
fi

PYTHON_VERSION="${1:-}"
if [ -n "$PYTHON_VERSION" ] && [[ ! "$PYTHON_VERSION" =~ ^3\.[0-9]+$ ]]; then
    echo -e "${RED}[x] error: Python version must look like 3.8, 3.11, or 3.14!${RESET}"
    exit 1
fi

rm -rf "${CONDA_PREFIX}/conda-bld/"

BUILD_ARGS=(--no-build-id --package-format 2 -c ckiddo74 -c conda-forge)
if [ -n "$PYTHON_VERSION" ]; then
    BUILD_ARGS+=(--python "$PYTHON_VERSION")
    echo -e "[i] building for Python ${BLUE}${PYTHON_VERSION}${RESET}"
fi

conda build "${BUILD_ARGS[@]}" conda/recipe/
