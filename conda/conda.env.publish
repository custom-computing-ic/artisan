#!/bin/bash

# Define ANSI color codes as environment variables
RED='\033[0;31m'
BLUE='\033[0;34m'
RESET='\033[0m'

# Check if environment.yml exists
if [[ ! -f "environment.yml" ]]; then
    echo -e "${RED}[x] error: environment.yml not found in the current directory!${RESET}"
    exit 1
fi

# Extract the environment name from the environment.yml file
ENV_NAME=$(grep -m 1 "^name:" environment.yml | awk '{print $2}')

if [ "$CONDA_DEFAULT_ENV" != "conda-build" ]; then
echo -e "${RED}[x] error: please activate 'conda-build' environment!${RESET}"
exit 1
fi

if [ "$#" -gt 2 ]; then
    echo -e "${RED}[x] syntax: $0 [python-version] [extract-dir]${RESET}"
    exit 1
fi

PYTHON_VERSION="${1:-}"
if [ -n "$PYTHON_VERSION" ] && [[ ! "$PYTHON_VERSION" =~ ^3\.[0-9]+$ ]]; then
    echo -e "${RED}[x] error: Python version must look like 3.8, 3.11, or 3.14!${RESET}"
    exit 1
fi

FIND_DIR="${CONDA_PREFIX}/conda-bld/linux-64/"

if [ -n "$PYTHON_VERSION" ]; then
    PYTHON_TAG="py${PYTHON_VERSION//./}"
    files=("${FIND_DIR}"${ENV_NAME}-*-${PYTHON_TAG}*.conda)
else
    files=("${FIND_DIR}"${ENV_NAME}-*.conda)
fi

# Remove the literal unmatched glob from the candidate list.
if [ ! -e "${files[0]}" ]; then
    files=()
fi

echo -e "[i] package location: ${BLUE}$FIND_DIR${RESET}"

if [ ${#files[@]} -eq 0 ]; then
    echo -e "${RED}[x] error: no package found for '$ENV_NAME'! ${RESET}"
    exit 1
elif [ ${#files[@]} -gt 1 ]; then
    echo -e "${RED}[x] error: multiple packages found; specify a Python version, e.g. $0 3.11${RESET}"
    printf '  %s\n' "${files[@]}"
    exit 1
fi

PACKAGE="${files[0]}"
echo -e "[i] target package: ${BLUE}$PACKAGE${RESET}"

if [ "$#" -eq 1 ] && [ -z "$PYTHON_VERSION" ]; then
    cph extract --prefix "$1" "$PACKAGE"
elif [ "$#" -eq 2 ]; then
    cph extract --prefix "$2" "$PACKAGE"
else
    anaconda upload --force "$PACKAGE"
    echo "[i] https://anaconda.org/ckiddo74/repo"
fi